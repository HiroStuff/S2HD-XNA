<?xml version="1.0"?>
<anigroup>
  <textures>
    <texture>//TEXTURE</texture>
  </textures>
  <animations>
    <!-- Walking left -->
    <animation delay="2">
      <frame texture="0" x="0" y="0" w="220" h="122" />
      <frame texture="0" x="220" y="0" w="220" h="122" />
      <frame texture="0" x="440" y="0" w="220" h="122" />
      <frame texture="0" x="660" y="0" w="220" h="122" />
      <frame texture="0" x="0" y="122" w="220" h="122" />
      <frame texture="0" x="220" y="122" w="220" h="122" />
      <frame texture="0" x="440" y="122" w="220" h="122" />
      <frame texture="0" x="660" y="122" w="220" h="122" />
      <frame texture="0" x="0" y="244" w="220" h="122" />
      <frame texture="0" x="220" y="244" w="220" h="122" />
      <frame texture="0" x="440" y="244" w="220" h="122" />
      <frame texture="0" x="660" y="244" w="220" h="122" />
    </animation>

    <!-- Walking right -->
    <animation delay="2">
      <frame texture="0" x="660" y="244" w="220" h="122" />
      <frame texture="0" x="440" y="244" w="220" h="122" />
      <frame texture="0" x="220" y="244" w="220" h="122" />
      <frame texture="0" x="0" y="244" w="220" h="122" />
      <frame texture="0" x="660" y="122" w="220" h="122" />
      <frame texture="0" x="440" y="122" w="220" h="122" />
      <frame texture="0" x="220" y="122" w="220" h="122" />
      <frame texture="0" x="0" y="122" w="220" h="122" />
      <frame texture="0" x="660" y="0" w="220" h="122" />
      <frame texture="0" x="440" y="0" w="220" h="122" />
      <frame texture="0" x="220" y="0" w="220" h="122" />
      <frame texture="0" x="0" y="0" w="220" h="122" />
    </animation>

    <!-- Shooting -->
    <animation loop="17">
      <frame texture="0" x="0" y="366" w="220" h="122" delay="1" />
      <frame texture="0" x="220" y="366" w="220" h="122" delay="1" />
      <frame texture="0" x="440" y="366" w="220" h="122" delay="1" />
      <frame texture="0" x="660" y="366" w="220" h="122" delay="3" />

      <frame texture="0" x="0" y="488" w="220" h="122" />
      <frame texture="0" x="220" y="488" w="220" h="122" />
      <frame texture="0" x="0" y="488" w="220" h="122" />
      <frame texture="0" x="220" y="488" w="220" h="122" />
      <frame texture="0" x="0" y="488" w="220" h="122" />
      <frame texture="0" x="220" y="488" w="220" h="122" />
      <frame texture="0" x="0" y="488" w="220" h="122" />
      <frame texture="0" x="220" y="488" w="220" h="122" />

      <frame texture="0" x="440" y="488" w="220" h="122" delay="1" />
      <frame texture="0" x="660" y="488" w="220" h="122" delay="1" />
      <frame texture="0" x="0" y="610" w="220" h="122" delay="1" />

      <frame texture="0" x="220" y="610" w="220" h="122" delay="2" />
      <frame texture="0" x="440" y="610" w="220" h="122" delay="2" />
      <frame texture="0" x="660" y="610" w="220" h="122" delay="1" />
    </animation>

    <!-- Plasma sphere -->
    <animation delay="2">
      <frame texture="0" x="0" y="804" w="50" h="50" />
      <frame texture="0" x="50" y="804" w="50" h="50" />
      <frame texture="0" x="100" y="804" w="50" h="50" />
    </animation>
  </animations>
</anigroup>