<?xml version="1.0"?>
<anigroup>
  <textures>
    <texture>//OUTER/TEXTURE</texture>
    <texture>//INNER/TEXTURE</texture>
  </textures>
  <animations>
    <!-- shell -->
    <animation>
      <frame texture="0" x="0" y="0" w="144" h="161" />
    </animation>
    <!-- shell overlay -->
    <animation>
      <frame texture="0" x="144" y="0" w="144" h="161" />
      <frame texture="0" x="288" y="0" w="144" h="161" />
    </animation>
    <!-- broken shell -->
    <animation>
      <frame texture="0" x="0" y="161" w="144" h="161" />
    </animation>
    <!-- broken shell sparks -->
    <animation delay="1">
      <frame delay="10" texture="0" x="144" y="483" w="144" h="161" />
      <frame texture="0" x="144" y="161" w="144" h="161" />
      <frame texture="0" x="288" y="161" w="144" h="161" />
      <frame texture="0" x="0" y="322" w="144" h="161" />
      <frame texture="0" x="144" y="483" w="144" h="161" />
      <frame texture="0" x="144" y="322" w="144" h="161" />
      <frame texture="0" x="288" y="322" w="144" h="161" />
      <frame texture="0" x="0" y="483" w="144" h="161" />
      <frame delay="32" texture="0" x="144" y="483" w="144" h="161" />
      <frame texture="0" x="144" y="161" w="144" h="161" />
      <frame texture="0" x="288" y="161" w="144" h="161" />
      <frame texture="0" x="0" y="322" w="144" h="161" />
      <frame texture="0" x="144" y="483" w="144" h="161" />
      <frame texture="0" x="144" y="322" w="144" h="161" />
      <frame texture="0" x="288" y="322" w="144" h="161" />
      <frame texture="0" x="0" y="483" w="144" h="161" />
      <frame delay="12" texture="0" x="144" y="483" w="144" h="161" />
    </animation>
    <!-- screen fuzz overlay -->
    <animation delay="1">
      <frame delay="26" texture="0" x="144" y="483" w="144" h="161" />
      <frame texture="1" x="0" y="0" w="84" h="78" />
      <frame texture="1" x="84" y="0" w="84" h="78" />
      <frame texture="1" x="0" y="0" w="84" h="78" />
      <frame delay="64" texture="0" x="144" y="483" w="144" h="161" />
      <frame texture="1" x="0" y="0" w="84" h="78" />
      <frame texture="1" x="84" y="0" w="84" h="78" />
      <frame texture="1" x="0" y="0" w="84" h="78" />
      <frame delay="26" texture="0" x="144" y="483" w="144" h="161" />
      <frame texture="1" x="0" y="0" w="84" h="78" />
      <frame texture="1" x="84" y="0" w="84" h="78" />
      <frame texture="1" x="168" y="0" w="84" h="78" />
      <frame texture="1" x="252" y="0" w="84" h="78" />
      <frame texture="1" x="168" y="0" w="84" h="78" />
      <frame texture="1" x="336" y="0" w="84" h="78" />
      <frame texture="1" x="168" y="0" w="84" h="78" />
      <frame texture="1" x="84" y="0" w="84" h="78" />
      <frame texture="1" x="0" y="0" w="84" h="78" />
    </animation>
    <!-- contents screen -->
    <!-- life (sonic) -->
    <animation>
      <frame texture="1" x="0" y="78" w="84" h="78" />
      <frame texture="1" x="84" y="78" w="84" h="78" />
    </animation>
    <!-- life (tails) -->
    <animation>
      <frame texture="1" x="252" y="78" w="84" h="78" />
      <frame texture="1" x="336" y="78" w="84" h="78" />
    </animation>
    <!-- robotnik -->
    <animation>
      <frame texture="1" x="0" y="156" w="84" h="78" />
      <frame texture="1" x="84" y="156" w="84" h="78" />
    </animation>
    <!-- ring -->
    <animation>
      <frame texture="1" x="252" y="156" w="84" h="78" />
      <frame texture="1" x="336" y="156" w="84" h="78" />
    </animation>
    <!-- speed shoes (sonic) -->
    <animation>
      <frame texture="1" x="0" y="234" w="84" h="78" />
      <frame texture="1" x="84" y="234" w="84" h="78" />
    </animation>
    <!-- speed shoes (tails) -->
    <animation>
      <frame texture="1" x="252" y="234" w="84" h="78" />
      <frame texture="1" x="336" y="234" w="84" h="78" />
    </animation>
    <!-- barrier -->
    <animation>
      <frame texture="1" x="0" y="312" w="84" h="78" />
      <frame texture="1" x="84" y="312" w="84" h="78" />
    </animation>
    <!-- invincibility -->
    <animation>
      <frame texture="1" x="252" y="312" w="84" h="78" />
      <frame texture="1" x="336" y="312" w="84" h="78" />
    </animation>
    <!-- swap -->
    <animation>
      <frame texture="1" x="0" y="390" w="84" h="78" />
      <frame texture="1" x="84" y="390" w="84" h="78" />
    </animation>
    <!-- random -->
    <animation>
      <frame texture="1" x="252" y="390" w="84" h="78" />
      <frame texture="1" x="336" y="390" w="84" h="78" />
    </animation>
    
    <!-- contents -->
    <!-- life (sonic) -->
    <animation>
      <frame texture="1" x="420" y="0" w="84" h="78" />
    </animation>
    <!-- life (tails) -->
    <animation>
      <frame texture="1" x="168" y="78" w="84" h="78" />
    </animation>
    <!-- robotnik -->
    <animation>
      <frame texture="1" x="420" y="78" w="84" h="78" />
    </animation>
    <!-- ring -->
    <animation>
      <frame texture="1" x="168" y="156" w="84" h="78" />
    </animation>
    <!-- speed shoes (sonic) -->
    <animation>
      <frame texture="1" x="420" y="156" w="84" h="78" />
    </animation>
    <!-- speed shoes (tails) -->
    <animation>
      <frame texture="1" x="168" y="234" w="84" h="78" />
    </animation>
    <!-- barrier -->
    <animation>
      <frame texture="1" x="420" y="234" w="84" h="78" />
    </animation>
    <!-- invincibility -->
    <animation>
      <frame texture="1" x="168" y="312" w="84" h="78" />
    </animation>
    <!-- swap -->
    <animation>
      <frame texture="1" x="420" y="312" w="84" h="78" />
    </animation>
    <!-- random -->
    <animation>
      <frame texture="1" x="168" y="390" w="84" h="78" />
    </animation>
  </animations>
</anigroup>