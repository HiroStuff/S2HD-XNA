<?xml version="1.0"?>
<anigroup>
  <textures>
    <texture>//TEXTURE0</texture>
    <texture>//TEXTURE1</texture>
    <texture>//TEXTURE2</texture>
  </textures>
  <animations>

    <!-- Blob -->
    <animation delay="0">
      <frame texture="0" x="0" y="0" w="84" h="84" />
      <frame texture="0" x="84" y="0" w="84" h="84" />
      <frame texture="0" x="168" y="0" w="84" h="84" />
      <frame texture="0" x="84" y="0" w="84" h="84" />
      <frame texture="0" x="0" y="0" w="84" h="84" />
      <frame texture="0" x="252" y="0" w="84" h="84" />
      <frame texture="0" x="336" y="0" w="84" h="84" />
      <frame texture="0" x="252" y="0" w="84" h="84" />
    </animation>

    <!-- Top splash start -->
    <animation delay="0">
      <frame texture="1" x="0" y="0" w="200" h="200" />
      <frame texture="1" x="200" y="0" w="200" h="200" />
      <frame texture="1" x="400" y="0" w="200" h="200" />
      <frame texture="1" x="600" y="0" w="200" h="200" />
      <frame texture="1" x="800" y="0" w="200" h="200" />
      <frame texture="1" x="1000" y="0" w="200" h="200" />
      <frame texture="1" x="0" y="200" w="200" h="200" />
      <frame texture="1" x="200" y="200" w="200" h="200" />    
      <frame texture="1" x="400" y="200" w="200" h="200" />        
    </animation>

    <!-- Top splash end -->
    <animation delay="1">
      <frame texture="1" x="600" y="200" w="200" h="200" />
      <frame texture="1" x="800" y="200" w="200" h="200" />
      <frame texture="1" x="1000" y="200" w="200" h="200" />
      <frame texture="1" x="0" y="400" w="200" h="200" />
      <frame texture="1" x="200" y="400" w="200" h="200" />
      <frame texture="1" x="400" y="400" w="200" h="200" />
      <frame texture="1" x="600" y="400" w="200" h="200" />  
      <frame texture="1" x="800" y="400" w="200" h="200" />  
      <frame texture="1" x="1000" y="400" w="200" h="200" />
      <frame texture="1" x="0" y="600" w="200" h="200" />    
      <frame texture="1" x="200" y="600" w="200" h="200" /> 
    </animation>

    <!-- Bottom splash start -->
    <animation delay="0">
      <frame texture="1" x="400" y="600" w="200" h="200" />
      <frame texture="1" x="600" y="600" w="200" h="200" />
      <frame texture="1" x="800" y="600" w="200" h="200" />
      <frame texture="1" x="1000" y="600" w="200" h="200" />
      <frame texture="1" x="0" y="800" w="200" h="200" />
      <frame texture="1" x="200" y="800" w="200" h="200" />
      <frame texture="1" x="400" y="800" w="200" h="200" />
      <frame texture="1" x="600" y="800" w="200" h="200" />    
      <frame texture="1" x="800" y="800" w="200" h="200" /> 
    </animation>

    <!-- Bottom splash end -->
    <animation delay="1">
      <frame texture="1" x="1000" y="800" w="200" h="200" />
      <frame texture="1" x="0" y="1000" w="200" h="200" />
      <frame texture="1" x="200" y="1000" w="200" h="200" />
      <frame texture="1" x="400" y="1000" w="200" h="200" />
      <frame texture="1" x="600" y="1000" w="200" h="200" />
      <frame texture="1" x="800" y="1000" w="200" h="200" />      
      <frame texture="1" x="1000" y="1000" w="200" h="200" />
      <frame texture="1" x="0" y="1200" w="200" h="200" />
      <frame texture="1" x="200" y="1200" w="200" h="200" />
      <frame texture="1" x="400" y="1200" w="200" h="200" />
      <frame texture="1" x="600" y="1200" w="200" h="200" />
      <frame texture="1" x="800" y="1200" w="200" h="200" />
      <frame texture="1" x="1000" y="1200" w="200" h="200" />
      <frame texture="1" x="0" y="1400" w="200" h="200" />
      <frame texture="1" x="200" y="1400" w="200" h="200" />
      <frame texture="1" x="400" y="1400" w="200" h="200" />      
      <frame texture="1" x="600" y="1400" w="200" h="200" /> 
      <frame texture="1" x="800" y="1400" w="200" h="200" />     
      <frame texture="1" x="1000" y="1400" w="200" h="200" />
      <frame texture="1" x="0" y="1600" w="200" h="200" />
      <frame texture="1" x="200" y="1600" w="200" h="200" />
      <frame texture="1" x="400" y="1600" w="200" h="200" />
      <frame texture="1" x="600" y="1600" w="200" h="200" />  
      <frame texture="1" x="800" y="1600" w="200" h="200" />
    </animation>

    <!-- Overflow -->
    <animation delay="0">
      <frame texture="2" x="0" y="0" w="128" h="46" />
      <frame texture="2" x="128" y="0" w="128" h="46" />
      <frame texture="2" x="256" y="0" w="128" h="46" />
      <frame texture="2" x="384" y="0" w="128" h="46" />
      <frame texture="2" x="512" y="0" w="128" h="46" />
      <frame texture="2" x="640" y="0" w="128" h="46" />
      <frame texture="2" x="0" y="46" w="128" h="46" />
      <frame texture="2" x="128" y="46" w="128" h="46" />
      <frame texture="2" x="256" y="46" w="128" h="46" />
      <frame texture="2" x="384" y="46" w="128" h="46" />
      <frame texture="2" x="512" y="46" w="128" h="46" />
      <frame texture="2" x="640" y="46" w="128" h="46" />
    </animation>
  </animations>
</anigroup>
