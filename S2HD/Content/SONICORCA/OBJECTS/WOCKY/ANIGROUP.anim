<?xml version="1.0"?>
<anigroup>
    <textures>
        <texture>//TEXTURE0</texture>
        <texture>//TEXTURE1</texture>
    </textures>
    <animations>
        <animation delay="3">
            <frame texture="0" x="0" y="0" w="128" h="128" />
        </animation>
        <animation delay="2">
            <frame texture="1" x="0" y="0" w="128" h="128" />
            <frame texture="1" x="128" y="0" w="128" h="128" />
            <frame texture="1" x="256" y="0" w="128" h="128" />
            <frame texture="1" x="384" y="0" w="128" h="128" />
            <frame texture="1" x="512" y="0" w="128" h="128" />
            <frame texture="1" x="640" y="0" w="128" h="128" />
        </animation>
    </animations>
</anigroup>
