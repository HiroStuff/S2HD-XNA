<?xml version="1.0"?>
<anigroup>
  <textures>
    <texture>//TEXTURE0</texture>
    <texture>//TEXTURE1</texture>
  </textures>
  <animations>
    
    <!-- dust -->
    <animation delay="3">
      <frame texture="0" x="0" y="0" w="64" h="64" />
      <frame texture="0" x="64" y="0" w="64" h="64" />
      <frame texture="0" x="128" y="0" w="64" h="64" />
      <frame texture="0" x="192" y="0" w="64" h="64" />
      <frame texture="0" x="0" y="64" w="64" h="64" />
      <frame texture="0" x="64" y="64" w="64" h="64" />
      <frame texture="0" x="128" y="64" w="64" h="64" />
      <frame texture="0" x="192" y="64" w="64" h="64" />
    </animation>
    
    <!-- smoke -->
    <animation delay="3">
      <frame texture="1" x="0" y="0" w="64" h="64" />
      <frame texture="1" x="64" y="0" w="64" h="64" />
      <frame texture="1" x="128" y="0" w="64" h="64" />
      <frame texture="1" x="192" y="0" w="64" h="64" />
      <frame texture="1" x="0" y="64" w="64" h="64" />
      <frame texture="1" x="64" y="64" w="64" h="64" />
      <frame texture="1" x="128" y="64" w="64" h="64" />
      <frame texture="1" x="192" y="64" w="64" h="64" />
    </animation>
  </animations>
</anigroup>