<?xml version="1.0"?>
<anigroup>
  <textures>
    <texture>//TEXTURE</texture>
  </textures>
  <animations>
    <!-- Side -->
    <animation>
      <frame texture="0" x="960" y="576" w="192" h="192" />
    </animation>

    <!-- Robotnik -->
    <animation next="2">
      <frame texture="0" x="0" y="0" w="192" h="192" />
      <frame texture="0" x="192" y="0" w="192" h="192" />
      <frame texture="0" x="384" y="0" w="192" h="192" />
      <frame texture="0" x="576" y="0" w="192" h="192" />
      <frame texture="0" x="768" y="0" w="192" h="192" />
    </animation>

    <animation>
      <frame texture="0" x="960" y="0" w="192" h="192" />
    </animation>

    <animation next="0">
      <frame texture="0" x="1152" y="0" w="192" h="192" />
      <frame texture="0" x="1344" y="0" w="192" h="192" />
      <frame texture="0" x="1536" y="0" w="192" h="192" />
      <frame texture="0" x="1728" y="0" w="192" h="192" />
      <frame texture="0" x="1920" y="0" w="192" h="192" />
    </animation>

    <!-- Sonic -->
    <animation  next="5">
      <frame texture="0" x="0" y="192" w="192" h="192" />
      <frame texture="0" x="192" y="192" w="192" h="192" />
      <frame texture="0" x="384" y="192" w="192" h="192" />
      <frame texture="0" x="576" y="192" w="192" h="192" />
      <frame texture="0" x="768" y="192" w="192" h="192" />
    </animation>

    <animation>
      <frame texture="0" x="960" y="192" w="192" h="192" />
    </animation>

    <animation next="0">
      <frame texture="0" x="1152" y="192" w="192" h="192" />
      <frame texture="0" x="1344" y="192" w="192" h="192" />
      <frame texture="0" x="1536" y="192" w="192" h="192" />
      <frame texture="0" x="1728" y="192" w="192" h="192" />
      <frame texture="0" x="1920" y="192" w="192" h="192" />
    </animation>

    <!-- Tails -->
    <animation next="8">
      <frame texture="0" x="0" y="384" w="192" h="192" />
      <frame texture="0" x="192" y="384" w="192" h="192" />
      <frame texture="0" x="384" y="384" w="192" h="192" />
      <frame texture="0" x="576" y="384" w="192" h="192" />
      <frame texture="0" x="768" y="384" w="192" h="192" />
    </animation>

    <animation>
      <frame texture="0" x="960" y="384" w="192" h="192" />
    </animation>

    <animation next="0">
      <frame texture="0" x="1152" y="384" w="192" h="192" />
      <frame texture="0" x="1344" y="384" w="192" h="192" />
      <frame texture="0" x="1536" y="384" w="192" h="192" />
      <frame texture="0" x="1728" y="384" w="192" h="192" />
      <frame texture="0" x="1920" y="384" w="192" h="192" />
    </animation>
  </animations>
</anigroup>
