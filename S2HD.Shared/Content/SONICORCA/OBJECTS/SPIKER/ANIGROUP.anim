<?xml version="1.0"?>
<anigroup>
  <textures>
    <texture>//TEXTURE0</texture>
	<texture>//TEXTURE1</texture>
  </textures>
  <animations>
    <!-- Drill: Stationary (facing left) -->
    <animation>
      <frame texture="0" x="0" y="0" w="227" h="204" />
    </animation>

    <!-- Drill: Spinning (when facing left) -->
    <animation delay="1">
      <frame texture="0" x="227" y="0" w="227" h="204" />
      <frame texture="0" x="454" y="0" w="227" h="204" />
      <frame texture="0" x="0" y="204" w="227" h="204" />
      <frame texture="0" x="227" y="204" w="227" h="204" />
      <frame texture="0" x="454" y="204" w="227" h="204" />
      <frame texture="0" x="0" y="408" w="227" h="204" />
      <frame texture="0" x="227" y="408" w="227" h="204" />
      <frame texture="0" x="454" y="408" w="227" h="204" />
      <frame texture="0" x="0" y="612" w="227" h="204" />
      <frame texture="0" x="227" y="612" w="227" h="204" />
      <frame texture="0" x="454" y="612" w="227" h="204" />
      <frame texture="0" x="0" y="816" w="227" h="204" />
    </animation>

    <!-- Body: Walking -->
    <animation delay="2">
      <frame texture="1" x="0" y="0" w="152" h="330" />
      <frame texture="1" x="152" y="0" w="152" h="330" />
      <frame texture="1" x="304" y="0" w="152" h="330" />
      <frame texture="1" x="456" y="0" w="152" h="330" />
      <frame texture="1" x="608" y="0" w="152" h="330" />
      <frame texture="1" x="0" y="330" w="152" h="330" />
      <frame texture="1" x="152" y="330" w="152" h="330" />
      <frame texture="1" x="304" y="330" w="152" h="330" />
      <frame texture="1" x="456" y="330" w="152" h="330" />
      <frame texture="1" x="608" y="330" w="152" h="330" />
    </animation>

    <!-- Body: Turning -->
    <animation delay="1">
      <frame texture="1" x="0" y="660" w="152" h="330" />
      <frame texture="1" x="152" y="660" w="152" h="330" />
      <frame texture="1" x="304" y="660" w="152" h="330" />
      <frame texture="1" x="456" y="660" w="152" h="330" />
    </animation>

    <!-- Drill: Stationary (facing right) -->
    <animation>
      <frame texture="0" x="227" y="1020" w="227" h="204" />
    </animation>

    <!-- Drill: Turning left to right -->
    <animation delay="1">
      <frame texture="0" x="0" y="0" w="227" h="204" />
      <frame texture="0" x="227" y="816" w="227" h="204" />
      <frame texture="0" x="454" y="816" w="227" h="204" />
      <frame texture="0" x="0" y="1020" w="227" h="204" />
    </animation>

    <!-- Drill: Spinning (when facing right) -->
    <animation delay="1">
      <frame texture="0" x="454" y="204" w="227" h="204" />
      <frame texture="0" x="0" y="408" w="227" h="204" />
      <frame texture="0" x="227" y="408" w="227" h="204" />
      <frame texture="0" x="454" y="408" w="227" h="204" />
      <frame texture="0" x="0" y="612" w="227" h="204" />
      <frame texture="0" x="227" y="612" w="227" h="204" />
      <frame texture="0" x="454" y="612" w="227" h="204" />
      <frame texture="0" x="0" y="816" w="227" h="204" />
      <frame texture="0" x="227" y="0" w="227" h="204" />
      <frame texture="0" x="454" y="0" w="227" h="204" />
      <frame texture="0" x="0" y="204" w="227" h="204" />
      <frame texture="0" x="227" y="204" w="227" h="204" />
    </animation>

    <!-- Drill: Turning right to left -->
    <animation delay="1">
      <frame texture="0" x="227" y="1020" w="227" h="204" />
      <frame texture="0" x="454" y="1020" w="227" h="204" />
      <frame texture="0" x="0" y="1224" w="227" h="204" />
      <frame texture="0" x="227" y="1224" w="227" h="204" />
    </animation>

  </animations>
</anigroup>