<?xml version="1.0"?>
<anigroup>
  <textures>
    <texture>//TEXTURE</texture>
  </textures>
  <animations>
    <animation delay="2" loop="6">
      <frame x="0"   y="0" w="96" h="190" />
      <frame x="96"  y="0" w="96" h="190" />
      <frame x="192" y="0" w="96" h="190" />
      <frame x="288" y="0" w="96" h="190" />
      <frame x="384" y="0" w="96" h="190" />
      <frame x="480" y="0" w="96" h="190" />
      <frame x="576" y="0" w="96" h="190" />
    </animation>
    <animation delay="2" next="2">
      <frame x="0"   y="190" w="96" h="190" />
      <frame x="96"  y="190" w="96" h="190" />
      <frame x="192" y="190" w="96" h="190" />
      <frame x="288" y="190" w="96" h="190" />
      <frame x="384" y="190" w="96" h="190" />
    </animation>
    <animation>
      <frame x="480" y="190" w="96" h="190" />
    </animation>
  </animations>
</anigroup>