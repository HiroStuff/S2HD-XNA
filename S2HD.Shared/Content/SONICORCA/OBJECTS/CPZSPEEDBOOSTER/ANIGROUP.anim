<?xml version="1.0"?>
<anigroup>
  <textures>
    <texture>//TEXTURE</texture>
  </textures>
  <animations>
    <!-- Frame -->
    <animation offset_y="113">
      <frame texture="0" x="64" y="0" w="256" h="156" />
    </animation>

    <!-- Core -->
    <animation offset_y="150" delay="1">
      <frame texture="0" x="320" y="0" w="137" h="81" />
      <frame texture="0" x="320" y="81" w="137" h="81" />
    </animation>

    <!-- Arrows -->
    <animation offset_y="53" delay="1">
      <frame texture="0" x="0" y="31" w="60" h="17" />
      <frame texture="0" x="0" y="48" w="60" h="17" />
      <frame texture="0" x="0" y="65" w="60" h="17" />
      <frame texture="0" x="0" y="82" w="60" h="17" />
    </animation>

    <!-- Spinner -->
    <animation offset_y="15" delay="0">
      <frame texture="0" x="0" y="224" w="120" h="96" />
      <frame texture="0" x="120" y="224" w="120" h="96" />
      <frame texture="0" x="240" y="224" w="120" h="96" />
      <frame texture="0" x="360" y="224" w="120" h="96" />
    </animation>

    <!-- Small wheel -->
    <animation offset_y="78" delay="1">
      <frame texture="0" x="0" y="161" w="32" h="31" />
      <frame texture="0" x="32" y="161" w="32" h="31" />
      <frame texture="0" x="64" y="161" w="32" h="31" />
      <frame texture="0" x="96" y="161" w="32" h="31" />
    </animation>
  </animations>
</anigroup>