<?xml version="1.0"?>
<anigroup>
  <textures>
    <texture>//TEXTURE</texture>
  </textures>
  <animations>
    <animation>
      <frame texture="0" x="128" y="128" w="128" h="128" />
    </animation>
    <animation delay="3">
      <frame texture="0" x="0" y="0" w="128" h="128" />
      <frame texture="0" x="128" y="0" w="128" h="128" />
      <frame texture="0" x="256" y="0" w="128" h="128" />
      <frame texture="0" x="0" y="128" w="128" h="128" />
    </animation>
  </animations>
</anigroup>