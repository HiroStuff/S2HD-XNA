<?xml version="1.0"?>
<anigroup>
  <textures>
    <texture>//TEXTURE</texture>
  </textures>
  <animations>
    <!-- Body: Stationary -->
    <animation offset_y="33">
      <frame texture="0" x="0" y="0" w="214" h="130" />
    </animation>
    
    <!-- Body: Stationary wiggle -->
    <animation next="0" delay="2" offset_y="33">
      <frame texture="0" x="0" y="390" w="214" h="130" />
      <frame texture="0" x="214" y="390" w="214" h="130" />
      <frame texture="0" x="428" y="390" w="214" h="130" />
      <frame texture="0" x="642" y="390" w="214" h="130" />
      <frame texture="0" x="0" y="520" w="214" h="130" />
      <frame texture="0" x="214" y="520" w="214" h="130" />
      <frame texture="0" x="428" y="520" w="214" h="130" />
      <frame texture="0" x="642" y="520" w="214" h="130" />
    </animation>
    
    <!-- Body: Turn begin -->
    <animation next="3" offset_y="33">
      <frame texture="0" x="214" y="0" w="214" h="130" delay="4" />
      <frame texture="0" x="428" y="0" w="214" h="130" delay="2" />
      <frame texture="0" x="642" y="0" w="214" h="130" delay="0" />
    </animation>
    
    <!-- Body: Turn end -->
    <animation offset_y="33" next="0">
      <frame texture="0" x="642" y="0" w="214" h="130" delay="0" />
      <frame texture="0" x="428" y="0" w="214" h="130" delay="2" />
      <frame texture="0" x="214" y="0" w="214" h="130" delay="4" />
    </animation>
    
    <!-- Body: Open -->
    <animation loop="2" offset_y="33">
      <frame texture="0" x="642" y="130" w="214" h="130" delay="2" />
      <frame texture="0" x="0" y="260" w="214" h="130" delay="3" />
      <frame texture="0" x="214" y="260" w="214" h="130" />
    </animation>
    
    <!-- Body: Close -->
    <animation next="0" delay="2" offset_y="33">
      <frame texture="0" x="428" y="260" w="214" h="130" />
      <frame texture="0" x="642" y="260" w="214" h="130" />
      <frame texture="0" x="0" y="130" w="214" h="130" />
      <frame texture="0" x="214" y="130" w="214" h="130" />
      <frame texture="0" x="428" y="130" w="214" h="130" />
    </animation>
    
    <!-- Body: Hold -->
    <animation offset_y="33">
      <frame texture="0" x="0" y="0" w="214" h="130" />
    </animation>
    
    <!-- Legs: Stationary -->
    <animation offset_x="-48" offset_y="59">
      <frame texture="0" x="0" y="650" w="118" h="90" />
    </animation>
    
    <!-- Legs: Open -->
    <animation loop="2" offset_x="-48" offset_y="59">
      <frame texture="0" x="472" y="650" w="118" h="90" delay="2" />
      <frame texture="0" x="354" y="650" w="118" h="90" delay="3" />
      <frame texture="0" x="590" y="650" w="118" h="90" />
    </animation>
    
    <!-- Legs: Close -->
    <animation next="7" delay="2" offset_x="-48" offset_y="59">
      <frame texture="0" x="708" y="650" w="118" h="90" />
      <frame texture="0" x="0" y="650" w="118" h="90" />
      <frame texture="0" x="118" y="650" w="118" h="90" />
      <frame texture="0" x="236" y="650" w="118" h="90" delay="4" />
    </animation>
    
    <!-- Legs: Hold -->
    <animation offset_x="-48" offset_y="59">
      <frame texture="0" x="0" y="650" w="118" h="90" />
    </animation>
    
    <!-- Legs: Hold wiggle -->
    <animation loop="35" delay="2" offset_x="-48" offset_y="59">
      <frame texture="0" x="708" y="650" w="118" h="90" />
      <frame texture="0" x="0" y="650" w="118" h="90" />
      <frame texture="0" x="0" y="650" w="118" h="90" />
      <frame texture="0" x="0" y="740" w="118" h="90" />
      <frame texture="0" x="118" y="740" w="118" h="90" />
      <frame texture="0" x="0" y="740" w="118" h="90" />
      <frame texture="0" x="118" y="740" w="118" h="90" />
      <frame texture="0" x="236" y="740" w="118" h="90" />
      <frame texture="0" x="354" y="740" w="118" h="90" />
      <frame texture="0" x="472" y="740" w="118" h="90" />
      <frame texture="0" x="354" y="740" w="118" h="90" />
      <frame texture="0" x="472" y="740" w="118" h="90" />
      <frame texture="0" x="590" y="740" w="118" h="90" />
      <frame texture="0" x="708" y="740" w="118" h="90" />
      <frame texture="0" x="590" y="740" w="118" h="90" />
      <frame texture="0" x="708" y="740" w="118" h="90" />
      <frame texture="0" x="0" y="830" w="118" h="90" />
      <frame texture="0" x="708" y="740" w="118" h="90" />
      <frame texture="0" x="118" y="740" w="118" h="90" />
      <frame texture="0" x="0" y="650" w="118" h="90" delay="24" />
      <frame texture="0" x="0" y="740" w="118" h="90" />
      <frame texture="0" x="118" y="740" w="118" h="90" />
      <frame texture="0" x="236" y="740" w="118" h="90" />
      <frame texture="0" x="354" y="740" w="118" h="90" />
      <frame texture="0" x="236" y="740" w="118" h="90" />
      <frame texture="0" x="354" y="740" w="118" h="90" />
      <frame texture="0" x="472" y="740" w="118" h="90" />
      <frame texture="0" x="708" y="740" w="118" h="90" />
      <frame texture="0" x="590" y="740" w="118" h="90" />
      <frame texture="0" x="708" y="740" w="118" h="90" />
      <frame texture="0" x="0" y="830" w="118" h="90" />
      <frame texture="0" x="590" y="740" w="118" h="90" />
      <frame texture="0" x="236" y="740" w="118" h="90" />
      <frame texture="0" x="0" y="650" w="118" h="90" />
      <frame texture="0" x="0" y="650" w="118" h="90" />
      <frame texture="0" x="0" y="650" w="118" h="90" />
    </animation>

    <!-- Wheels -->
    <animation delay="2" offset_x="-10" offset_y="-48">
      <frame texture="0" x="118" y="830" w="35" h="32" />
      <frame texture="0" x="153" y="830" w="35" h="32" />
      <frame texture="0" x="188" y="830" w="35" h="32" />
    </animation>

    <!-- Thread -->
    <animation delay="2">
      <frame texture="0" x="223" y="830" w="3" h="1" />
    </animation>
    
    <!-- Body: Explode -->
    <animation offset_y="33">
      <frame texture="0" x="226" y="830" w="214" h="130" />
    </animation>
  </animations>
</anigroup>