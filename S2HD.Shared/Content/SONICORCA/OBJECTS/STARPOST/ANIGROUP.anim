<?xml version="1.0"?>
<anigroup>
  <textures>
    <texture>//TEXTURE</texture>
  </textures>
  <animations>
    <!-- starpost -->
    <animation>
	  <frame texture="0" x="0" y="0" w="100" h="300" />
    </animation>
	<!-- inactive -->
	<animation>
	  <frame texture="0" x="100" y="0" w="64" h="64" />
    </animation>
	<!-- active -->
	<animation delay="4">
	  <frame texture="0" x="100" y="64" w="128" h="128" />
	  <frame texture="0" x="100" y="192" w="128" h="128" />
    </animation>
	<!-- active glow -->
	<animation delay="4">
	  <frame texture="0" x="228" y="64" w="128" h="128" />
	  <frame texture="0" x="228" y="192" w="128" h="128" />
    </animation>
  </animations>
</anigroup>