<?xml version="1.0"?>
<anigroup>
  <textures>
    <texture>//TEXTURE</texture>
  </textures>
  <animations>
    <!-- normal -->
    <animation delay="2">
      <frame texture="0" x="0" y="0" w="226" h="132" />
      <frame texture="0" x="226" y="0" w="226" h="132" />
      <frame texture="0" x="452" y="0" w="226" h="132" />
      <frame texture="0" x="678" y="0" w="226" h="132" />
      <frame texture="0" x="0" y="132" w="226" h="132" />
      <frame texture="0" x="226" y="132" w="226" h="132" />
    </animation>

    <!-- smile -->
    <animation delay="2" next="0">
      <frame texture="0" x="452" y="132" w="226" h="132" />
      <frame texture="0" x="678" y="132" w="226" h="132" />
      <frame texture="0" x="0" y="264" w="226" h="132" />
      <frame texture="0" x="226" y="264" w="226" h="132" />
      <frame texture="0" x="452" y="264" w="226" h="132" />
      <frame texture="0" x="678" y="264" w="226" h="132" />
      <frame texture="0" x="678" y="132" w="226" h="132" />
      <frame texture="0" x="0" y="264" w="226" h="132" />
      <frame texture="0" x="226" y="264" w="226" h="132" />
      <frame texture="0" x="452" y="264" w="226" h="132" />
      <frame texture="0" x="678" y="264" w="226" h="132" />
      <frame texture="0" x="678" y="132" w="226" h="132" />
      <frame texture="0" x="0" y="264" w="226" h="132" />
      <frame texture="0" x="226" y="264" w="226" h="132" />
      <frame texture="0" x="452" y="264" w="226" h="132" />
      <frame texture="0" x="678" y="264" w="226" h="132" />
      <frame texture="0" x="0" y="396" w="226" h="132" />
      <frame texture="0" x="452" y="132" w="226" h="132" />
    </animation>
    
    <!-- hit -->
    <animation delay="2" next="0">
      <frame texture="0" x="226" y="396" w="226" h="132" />
      <frame texture="0" x="452" y="396" w="226" h="132" />
      <frame texture="0" x="678" y="396" w="226" h="132" />
      <frame texture="0" x="452" y="396" w="226" h="132" />
      <frame texture="0" x="678" y="396" w="226" h="132" />
      <frame texture="0" x="452" y="396" w="226" h="132" />
      <frame texture="0" x="678" y="396" w="226" h="132" />
      <frame texture="0" x="226" y="396" w="226" h="132" />
    </animation>

    <!-- defeated -->
    <animation delay="2" loop="14">
      <frame texture="0" x="226" y="396" w="226" h="132" />
      <frame texture="0" x="452" y="396" w="226" h="132" />
      <frame texture="0" x="678" y="396" w="226" h="132" />
      <frame texture="0" x="0" y="528" w="226" h="132" />
      <frame texture="0" x="226" y="528" w="226" h="132" />
      <frame texture="0" x="452" y="528" w="226" h="132" />
      <frame texture="0" x="678" y="528" w="226" h="132" />
      <frame texture="0" x="0" y="660" w="226" h="132" />
      <frame texture="0" x="226" y="660" w="226" h="132" />
      <frame texture="0" x="452" y="660" w="226" h="132" />
      <frame texture="0" x="678" y="660" w="226" h="132" />
      <frame texture="0" x="0" y="792" w="226" h="132" />
      <frame texture="0" x="226" y="792" w="226" h="132" />
      <frame texture="0" x="452" y="792" w="226" h="132" />
      <frame texture="0" x="678" y="792" w="226" h="132" />
    </animation>

    <!-- turning, 1 -->
    <animation delay="4" loop="2">
      <frame texture="0" x="0" y="924" w="226" h="132" />
      <frame texture="0" x="226" y="924" w="226" h="132" />
      <frame texture="0" x="452" y="924" w="226" h="132" />
    </animation>
    <!-- turning, 2 -->
    <animation delay="4" next="0">
      <frame texture="0" x="452" y="924" w="226" h="132" />
      <frame texture="0" x="226" y="924" w="226" h="132" />
      <frame texture="0" x="0" y="924" w="226" h="132" />
    </animation>
  </animations>
</anigroup>