<?xml version="1.0"?>
<anigroup>
  <textures>
    <texture>//TEXTURE</texture>
	<texture>//PARTICLE/TEXTURE</texture>
  </textures>
  <animations>
    <animation>
	  <frame texture="0" x="0" y="0" w="192" h="256" />
	</animation>
    <animation delay="2">
      <frame texture="1" x="0" y="0" w="120" h="120" />
      <frame texture="1" x="120" y="0" w="120" h="120" />
      <frame texture="1" x="0" y="120" w="120" h="120" />
      <frame texture="1" x="120" y="120" w="120" h="120" />
      <frame texture="1" x="0" y="240" w="120" h="120" />
      <frame texture="1" x="120" y="240" w="120" h="120" />
      <frame texture="1" x="0" y="360" w="120" h="120" />
      <frame texture="1" x="120" y="360" w="120" h="120" />
	</animation>
  </animations>
</anigroup>