<?xml version="1.0"?>
<font>
	<name>Sonic 1+ font used for point objects to show score rewards.</name>
	<shape>/SHAPE</shape>
	<width>20</width>
	<height>36</height>
	<tracking>0</tracking>
	<chardefs>
        <chardef char="0">
          <rect x="0" y="0" w="20" h="36" />
        </chardef>
        <chardef char="1">
          <rect x="21" y="0" w="15" h="36" />
        </chardef>
		<chardef char="2">
          <rect x="35" y="0" w="20" h="36" />
        </chardef>
		<chardef char="5">
          <rect x="55" y="0" w="20" h="36" />
        </chardef>
	</chardefs>
</font>