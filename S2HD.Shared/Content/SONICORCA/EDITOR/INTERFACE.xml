<?xml version="1.0" encoding="utf-8"?>
<interface>
  <topmenu>
    <item text="LEVEL">
	  <item text="OPEN" function="openmap" />
  	  <seperator />
	  <item text="SAVE" shortcut="CTRL+S" function="savemap" />
	  <item text="SAVE AS..." function="savemapas" />
	  <seperator />
	  <item text="EXIT" shortcut="ALT+F4" function="exit" />
	</item>
	<item text="EDIT">
	  <item text="UNDO" shortcut="CTRL+Z" function="undo" />
	  <item text="REDO" shortcut="CTRL+Y" function="redo" />
	  <seperator />
	  <item text="CUT" shortcut="CTRL+X" function="cut" />
	  <item text="COPY" shortcut="CTRL+C" function="copy" />
	  <item text="PASTE" shortcut="CTRL+V" function="paste" />
	  <item text="DELETE" shortcut="DEL" function="delete" />
	</item>
	<item text="HELPERS">
	  <item text="ADD BOOKMARK" function="addbookmark" />
	  <item text="REMOVE BOOKMARK" function="removebookmark" />
	  <item text="PREVIOUS BOOKMARK" shortcut="F9" function="previousbookmark" />
	  <item text="NEXT BOOKMARK" shortcut="F10" function="nextbookmark" />
	</item>
	<item text="VIEW">
	  <check text="SHOW RULERS" function="showrulers" />
	  <check text="SHOW MINIMAP" function="showminimap" />
	  <seperator />
	  <check text="SHOW TILES" function="showtiles" />
	  <check text="SHOW OBJECTS" function="showobjects" />
	  <check text="SHOW MARKERS" function="showmarkers" />
	  <check text="SHOW TILE COLLISION" function="showtilecollision" />
	  <check text="SHOW OBJECT COLLISION" function="showobjectcollision" />
	</item>
	<item text="HELP">
	</item>
  </topmenu>
</interface>